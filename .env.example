# Copie para .env.local e preencha. Nunca commite .env.local.
# Variáveis NEXT_PUBLIC_* vão para o navegador; as demais ficam só no servidor.
# Só o bloco Supabase é obrigatório; cada integração vazia desliga apenas o recurso dela.

# App (usado como base das rotas de cron; links para clientes usam o domínio da marca)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Teste de pagamento real: preço do plano em centavos para todos (mínimo do Asaas: 500 = R$ 5).
# Deixe vazio em uso normal.
NEXT_PUBLIC_PRICE_TEST_CENTS=
# Marca usada em hosts desconhecidos (padrão: beauty)
DEFAULT_BRAND=beauty

# Guia passo a passo: docs/SETUP.md. Conferir: npm run check:setup

# Supabase (Project Settings > API Keys). Projetos novos chamam a pública de "publishable"
# e a secreta de "secret": cole a publishable em ANON_KEY e a secret em SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Resend. Em produção o remetente vem de emailFrom de cada marca;
# RESEND_FROM sobrescreve enquanto o domínio da marca não está verificado: só o endereço
# (ex.: nao-responda@seudominio.com.br) mantém o nome de cada marca; "Nome <endereço>" troca tudo.
RESEND_API_KEY=
RESEND_FROM=

# Web push (gerar com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Rotas /api/cron/* (mínimo 32 caracteres aleatórios)
CRON_SECRET=

# Chave de 32 bytes em base64: cifra tokens do Google e protege chaves de limite de chamadas.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Asaas (checkout próprio no painel; o Asaas só processa por trás). sandbox | production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox

# Google OAuth (Google Agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel (domínio próprio dos negócios)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Acesso ao /admin (e-mails separados por vírgula)
ADMIN_EMAILS=

# Sentry (opcional em desenvolvimento; sem DSN o Sentry fica desligado)
NEXT_PUBLIC_SENTRY_DSN=
