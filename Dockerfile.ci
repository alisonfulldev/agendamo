# Imagem só de execução, usada pelo GitHub Actions (.github/workflows/deploy.yml).
# O `next build` roda uma vez no runner (é a parte pesada); aqui só copiamos o
# resultado. Para build completo dentro do Docker (sem Actions), use o Dockerfile.

FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

COPY public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
# Fontes lidas em tempo de execução (/og e artes de venda); garante mesmo se o tracing falhar
COPY assets/fonts ./assets/fonts
# Dados de português do OCR dos comprovantes de Pix (tesseract.js)
COPY assets/tessdata ./assets/tessdata

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
