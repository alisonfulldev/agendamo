# Variáveis de execução do agendamo na VPS. Na VPS este arquivo vira /opt/apps/agendamo.env
# (chmod 600). Sem aspas nos valores. Gerado a partir do `vercel env pull` (ver DEPLOY-VPS.md).
# As NEXT_PUBLIC_* também precisam estar no GitHub: elas são gravadas no JS durante o build.

# Liga domínios das marcas, redirect do www e IndexNow
APP_ENV=production

NEXT_PUBLIC_APP_URL=https://meetchat.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CONTACT_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

RESEND_API_KEY=
RESEND_FROM=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

CRON_SECRET=
ENCRYPTION_KEY=
ADMIN_EMAILS=

ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=production

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INDEXNOW_KEY=
